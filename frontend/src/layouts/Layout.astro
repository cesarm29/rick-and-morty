---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'API de Rick & Morty con NestJS y frontend Astro' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <style>
      :root {
        --bg: #0b1524;
        --bg-card: #14283f;
        --accent: #71d6a0;
        --accent-2: #55b7f0;
        --text: #e6edf5;
        --muted: #8ba3bf;
        --border: #1e3a5a;
        --radius: 14px;
        --shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: radial-gradient(circle at 20% 0%, #1b3a5f 0%, var(--bg) 55%);
        color: var(--text);
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.5;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
      header {
        border-bottom: 1px solid var(--border);
        background: rgba(11, 21, 36, 0.7);
        backdrop-filter: blur(6px);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 0;
      }
      .brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 800; font-size: 1.15rem; }
      .brand img { width: 34px; height: 34px; border-radius: 8px; }
      .brand span span.accent { color: var(--accent); }
      nav ul { list-style: none; display: flex; gap: 1.25rem; margin: 0; padding: 0; }
      nav a { color: var(--muted); text-decoration: none; font-weight: 600; font-size: 0.95rem; }
      nav a:hover { color: var(--text); }
      main { flex: 1; padding: 2rem 0 3rem; }
      footer {
        border-top: 1px solid var(--border);
        padding: 1.25rem 0;
        color: var(--muted);
        font-size: 0.85rem;
      }
      .footer-inner { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
      h1 { margin: 0 0 0.5rem; font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.1; }
      .sub { color: var(--muted); margin: 0 0 1.5rem; max-width: 60ch; }
      .accent { color: var(--accent); }
      @media (max-width: 640px) {
        nav ul { gap: 0.9rem; }
        .footer-inner { justify-content: center; text-align: center; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container header-inner">
        <a href="/" class="brand" style="text-decoration:none;color:inherit;">
          <img src="/favicon.svg" alt="" />
          <span>Rick <span class="accent">&</span> Morty <span class="accent">API</span></span>
        </a>
        <nav>
          <ul>
            <li><a href="/">Personajes</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer>
      <div class="container footer-inner">
        <span>API NestJS + Frontend Astro · Rick & Morty</span>
        <span>Deploy en Vercel</span>
      </div>
    </footer>
  </body>
</html>
